<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Wi-Fi Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Wi-Fi Settings"
            android:textSize="20sp"
            android:paddingTop="8dp"/>

        <EditText
            android:id="@+id/editSsid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Home Wi-Fi SSID"
            android:inputType="text" />

        <EditText
            android:id="@+id/editPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Wi-Fi Password"
            android:inputType="textPassword" />

        <!-- ESP32-C6 Settings -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ESP32-C6 Network"
            android:textSize="20sp"
            android:paddingTop="16dp"/>

        <EditText
            android:id="@+id/editC6Ip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="ESP32-C6 Static IP (e.g. 10.0.0.23)"
            android:inputType="text" />

        <EditText
            android:id="@+id/editGateway"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Gateway (e.g. 10.0.0.2)"
            android:inputType="text" />

        <EditText
            android:id="@+id/editSubnet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Subnet Mask (e.g. 255.255.255.0)"
            android:inputType="text" />

        <EditText
            android:id="@+id/editOtaPass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="OTA Password"
            android:inputType="text" />

        <!-- Geyser / Pool Devices -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Connected Devices"
            android:textSize="20sp"
            android:paddingTop="16dp"/>

        <EditText
            android:id="@+id/inverterIp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Inverter IP"
            android:inputType="text" />

        <EditText
            android:id="@+id/editGeyser1Ip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Geyser 1 IP"
            android:inputType="text" />

        <EditText
            android:id="@+id/editGeyser2Ip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Geyser 2 IP"
            android:inputType="text" />

        <EditText
            android:id="@+id/editPollInterval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Poll Interval (seconds)"
            android:inputType="number" />

        <!-- Buttons -->
        <Button
            android:id="@+id/btnSendToC6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Send to ESP32-C6"
            android:layout_marginTop="8dp"/>

    </LinearLayout>
</ScrollView>
